# ─────────────────────────────────────────────────────────────────────
# FloodCast Gurugram — backend configuration
#
# EVERY SETTING BELOW IS OPTIONAL. Copy to .env only if you want to
# change a default. The app runs with no configuration at all:
# Open-Meteo needs no key, and the chat pipeline falls back to a
# deterministic rule-based engine without AWS credentials.
# ─────────────────────────────────────────────────────────────────────

# ── Weather ──────────────────────────────────────────────────────────
# open-meteo (default, no key required) | openweathermap (needs a key)
WEATHER_PROVIDER=open-meteo

# Optional. Enables OpenWeatherMap as an alternative provider.
# Free key: https://openweathermap.org/api  (Current Weather Data plan)
# Note its free forecast is 3-hourly, which averages away the short
# cloudbursts that actually flood Gurugram — Open-Meteo is hourly.
OPENWEATHERMAP_API_KEY=

# ── LLM: Claude on AWS Bedrock (optional) ────────────────────────────
# Leave blank to run the deterministic verdict pipeline, which is fully
# functional. To enable the LLM you need:
#   1. An AWS account with Bedrock enabled in your region
#   2. Model access granted for Claude Haiku and Sonnet
#      (AWS Console -> Bedrock -> Model access -> Manage model access;
#       approval is a manual step and is not instant)
#   3. An IAM user/role with bedrock:InvokeModel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Bedrock model IDs are the first-party Claude IDs with an `anthropic.`
# prefix. Configurable so they can be updated without a code change.
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-haiku-4-5
BEDROCK_SONNET_MODEL_ID=anthropic.claude-sonnet-5

# ── Web ──────────────────────────────────────────────────────────────
# Comma-separated exact origins. Never a wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CHAT_RATE_LIMIT=10/minute
REPORT_RATE_LIMIT=5/hour

# ── Geocoding fallback ───────────────────────────────────────────────
# Only used for place names absent from the hotspot and landmark tables.
# Nominatim's usage policy requires a real contact address and returns
# 403 for placeholder domains — set this before relying on the fallback.
NOMINATIM_CONTACT=you@example.org

# ── Tuning ───────────────────────────────────────────────────────────
WEATHER_CACHE_TTL_SECONDS=3600
CORRIDOR_BUFFER_KM=1.5
TIMELINE_HOURS=8
REPORTS_STORE_PATH=var/citizen_reports.json
