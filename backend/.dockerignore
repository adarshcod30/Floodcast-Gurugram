# Without this, `COPY . .` pulls the local virtualenv (hundreds of MB of
# host-platform binaries) into the image — bloating the build, slowing
# every deploy, and potentially shadowing the correctly-installed
# site-packages with wheels built for a different platform.
.venv/
venv/
env/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets must never enter an image layer.
.env
.env.*
!.env.example

# Runtime state belongs to the running container, not the image.
var/

# Not needed at runtime.
tests/
.git/
.gitignore
*.md
!data/DATA_PROVENANCE.md

.DS_Store
