# ── Secrets ─────────────────────────────────────────────────────────
# Never commit credentials. .env.example is the committed template.
#
# frontend/.env.production is the one exception, and only because what it
# holds is not a credential: a Supabase publishable key grants no authority
# and ships in the client bundle of every Supabase app regardless. The
# file itself explains the reasoning and lists the specific things that key
# was verified unable to do. A service_role key must never go near it.
.env
.env.*
!.env.example
!frontend/.env.production

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / frontend ─────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ── Runtime state ───────────────────────────────────────────────────
# Citizen reports are persisted to disk at runtime; the store is user
# data, not source, and must never be committed.
backend/var/

# ── Editors & OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
