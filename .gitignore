# ── Secrets ─────────────────────────────────────────────────────────
# Never commit credentials. .env.example is the committed template.
# frontend/.env.production is also excepted: it holds only the public
# backend URL Vite bakes into the client bundle at build time (Vercel's
# vercel.json "env" key does not reach the Vite build step, so this is
# the actual mechanism, not a convenience duplicate of it).
.env
.env.*
!.env.example
!frontend/.env.production

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / frontend ─────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ── Runtime state ───────────────────────────────────────────────────
# Citizen reports are persisted to disk at runtime; the store is user
# data, not source, and must never be committed.
backend/var/

# ── Editors & OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
